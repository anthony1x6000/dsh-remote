{
  "name": "dsh-remote",
  "version": "0.2.0",
  "description": "Serve the DSH webserver over Tailscale, with remote model and API-key editing",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "webserver",
    "remote-access"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "selfcheck": "node --experimental-strip-types selfcheck.ts"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthony1x6000/dsh-remote.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
